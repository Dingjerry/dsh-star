{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Star",
  "version": "0.1.0",
  "identifier": "app.dshstar.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" },
    "windows": [{
      "label": "main",
      "title": "DSH Star · v0.1.0",
      "width": 1200,
      "height": 800,
      "minWidth": 900,
      "minHeight": 620,
      "resizable": true,
      "center": true,
      "visible": false
    }]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "category": "DeveloperTool",
    "shortDescription": "Desktop DeepSeek Harness",
    "longDescription": "基于 DeepSeek Harness 官方开源源码，使用 Tauri 2 与 Rust 封装的社区桌面版。",
    "copyright": "基于 DeepSeek Harness 官方开源源码，使用 Tauri 2 与 Rust 封装的社区桌面版。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
