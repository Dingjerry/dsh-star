{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum capability set for the DSH Star boot window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-desktop-status",
    "allow-runtime-bootstrap",
    "allow-set-launch-at-login",
    "allow-set-close-behavior",
    "allow-close-window-action",
    "allow-updates"
  ]
}
